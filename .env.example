# DropWatch Environment Variables Configuration Example
# Copy to .env for local development overrides

# MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/dropwatch?replicaSet=rs0

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=dropwatch
SPRING_RABBITMQ_PASSWORD=dropwatch123

# Server & Security
SERVER_PORT=8080
DROPWATCH_JWT_SECRET=9a8f7e6d5c4b3a210987654321fedcba9a8f7e6d5c4b3a210987654321fedcba

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=DropWatchBot
TELEGRAM_MODE=long-polling
